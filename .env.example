# Every setting the app reads from the environment. Copy to `.env` to override;
# without a `.env` the defaults in src/lib/config.ts (production) are used.

# Stats API. Point at a local LRG2 build to use endpoints that haven't shipped.
VITE_LRG2_API=https://stats.spectral.gg/lrg2/api/
# Deployed stats API, used as a fallback when the one above can't answer.
VITE_LRG2_API_PUBLIC=https://stats.spectral.gg/lrg2/api/
# Image CDN: portraits, item icons, facet icons.
VITE_COURIER_BASE=https://courier.spectral.gg/images/dota
# Public match history, for the personalised grids.
VITE_OPENDOTA_API=https://api.opendota.com/api
# Site the ❮ back-link returns to, and the app's own landing route.
VITE_PARENT_URL=https://spectral.gg
VITE_SECTION_HOME=/view
# Shown in About and used to decide whether to open the what's-new dialog.
VITE_APP_VERSION=3.0.0
